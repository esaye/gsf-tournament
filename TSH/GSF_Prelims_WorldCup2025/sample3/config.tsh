# 2005 NSSC
# An example of a tournament where player names are actually team names
config event_name = "2005 NSSC"
division a a.t
#
autopair a 1 2 ns 0 1
autopair a 2 3 ns 0 2
autopair a 3 4 ns 0 3
autopair a 4 5 ns 0 4
autopair a 5 6 koth 1 5
# 
config track_firsts = 1
config assign_firsts = 0
config max_rounds = 6
