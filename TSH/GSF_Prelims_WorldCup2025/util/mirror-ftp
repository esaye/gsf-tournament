sub UpdateConfigFiles ($) {
  my $esp = shift;
  my $updated = 0;
  while (my ($en, $ep) = each %$esp) {
    mkdir "flags/$en";
    my $config = $ep->{'tourney'}->Config();
    next if $config->Value('_is_raw');
    my $ftp_path = $config->Value('ftp_path');
    my $u = UpdateText(
      $ep,
      File::Spec->catfile('flags', $en, 'config.tsh'),
