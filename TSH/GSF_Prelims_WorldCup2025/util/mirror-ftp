      "$ftp_path/$en/config.tsh",
      );
    $updated ||= $u;
    }
  return $updated;
  }

=item Use $module or die

Carefully evaluate "use $module" and try to explain to a naive user
the meaning of failure.

=cut

sub Use ($;$) {
  my $module = shift;
  my $quiet = shift;
  eval "use $module";
  if ($@) {
    exit 1 if $quiet;
    sleep 2;
    die "Couldn't load $module, most likely because your tsh software distribution\nis incomplete.  Please download it again.  Here is what Perl says caused\nthe problem:\n$@";
    }
  return 1;
  }

sub Usage () {
  die "Usage: $0 [--username username] [--password password] [--once] [event-folder...]\n";
  }

package RawTourney;

sub new (@) {
  my $proto = shift;
  my $class = ref($proto) || $proto;
  my (%options) = @_;
  my $this = { 'config' => new RawConfig(%options) };
  bless $this, $class;
  return $this;
  }

sub Config ($) { my $this = shift; return $this->{'config'}; }

package RawConfig;

sub new (@) {
  my $proto = shift;
  my $class = ref($proto) || $proto;
  my (%options) = @_;
  my $this = \%options;
  bless $this, $class;
  return $this;
  }

sub MakeRootPath ($$) { my $this = shift; my $path = shift;  return "$this->{'local_path'}/$path"; }

sub Value ($$) { my $this = shift; my $key = shift;  return $this->{$key}; }

